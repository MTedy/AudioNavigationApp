<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="App.UI.MainWindow"
        Title="Nawigacja Audio - Radar"
        Width="800" Height="600">

    <Canvas Name="MainCanvas" Background="#1E1E1E">
        <!-- źródło dźwięku -->

        <!-- gracz -->
        <Ellipse Name="PlayerDot" Width="20" Height="20" Fill="DodgerBlue" />
        <Line Name="PlayerDirection" Stroke="Red" StrokeThickness="3"/>
    </Canvas>
</Window>
